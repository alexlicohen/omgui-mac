<?xml version='1.0'?>
<!-- Ported from "Plugins for release/Plugins/OmConvertPlugin/AX_OMConvert.plugin".
     Only runFilePath changes: the Windows batch file becomes a shell script that calls the
     omconvert bundled in OmGui.app/Contents/Helpers. -->
<Plugin>
	<height>500</height>
	<width>700</width>
	<runFilePath>run-omconvert.sh</runFilePath>
	<htmlFilePath>AX_OMConvert.html</htmlFilePath>
	<savedValuesFilePath>saved.xml</savedValuesFilePath>
	<description>OMConvert</description>
	<fileName>OMConvert</fileName>
	<readableName>OMConvert</readableName>
	<outputExtensions>
		<extension></extension>
	</outputExtensions>
	<numberOfInputFiles>1</numberOfInputFiles>
	<wantMetadata>false</wantMetadata>
	<requiresCWANames>true</requiresCWANames>
</Plugin>
